{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phased-timer",
  "compatibility_date": "2026-05-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "phasedtimer.dgapps.io",
      "custom_domain": true
    }
  ]
}
